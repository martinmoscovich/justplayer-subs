<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory app:title="Quick setup">
        <Preference
            app:key="pref_qr_setup"
            app:title="Set up via QR (phone)"
            app:summary="Scan a QR code from your phone to fill in API keys and languages" />
    </PreferenceCategory>

    <PreferenceCategory app:title="General">
        <Preference
            app:key="pref_source_languages"
            app:title="Preferred source languages"
            app:summary="Languages to search and translate from, in priority order" />
        <Preference
            app:key="pref_target_languages"
            app:title="Target languages"
            app:summary="Preferred subtitle languages to show / translate to, in priority order" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Selection">
        <SwitchPreferenceCompat
            app:key="pref_auto_select"
            app:title="Auto-select subtitle"
            app:summary="Pick the best available subtitle by language priority, and re-check as embedded tracks and search results arrive"
            app:defaultValue="@bool/subs_default_auto_select" />
        <EditTextPreference
            app:key="opensubtitles_api_key"
            app:title="OpenSubtitles API key"
            app:dialogTitle="OpenSubtitles API key"
            app:summary="Required to search OpenSubtitles"
            app:useSimpleSummaryProvider="false" />
    </PreferenceCategory>

    <!-- Sin app:defaultValue a propósito: estos valores los define el engine
         (SyncSettings.defaults()) y SubtitleSettingsFragment.refreshFromStorage() los siembra desde
         ahí en onResume, que corre siempre antes de que se vean. Repetirlos acá sería una copia que
         puede desincronizarse del valor que el sync realmente usa. -->
    <PreferenceCategory app:title="Sync">
        <EditTextPreference
            app:key="pref_reaction_ms"
            app:title="Reaction time (ms)"
            app:summary="Anchoring is back-dated by this much to absorb your reaction time"
            />
        <EditTextPreference
            app:key="pref_nudge_ms"
            app:title="Nudge step (ms)"
            />
        <EditTextPreference
            app:key="pref_seek_s"
            app:title="Seek step (s)"
            />
        <EditTextPreference
            app:key="pref_segment_gap_s"
            app:title="Segment gap (s)"
            app:summary="A silence longer than this starts a new dialogue segment"
            />
        <EditTextPreference
            app:key="pref_segment_restart_s"
            app:title="Prev-segment restart threshold (s)"
            app:summary="'Prev seg' restarts the current segment if you are at least this far into it"
            />
    </PreferenceCategory>

    <PreferenceCategory app:title="Translation">
        <ListPreference
            app:key="pref_ai_provider"
            app:title="AI provider"
            app:entries="@array/ai_provider_entries"
            app:entryValues="@array/ai_provider_values"
            app:defaultValue="@string/subs_default_ai_provider"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:key="pref_ai_model"
            app:title="Model"
            app:defaultValue="@string/subs_default_ai_model"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:key="pref_ai_api_key"
            app:title="AI API key"
            app:dialogTitle="AI API key"
            app:summary="OpenRouter / Gemini API key" />
    </PreferenceCategory>

    <!-- El summary de "Clear debug logs" lo escribe SubtitleSettingsFragment (cantidad de archivos y
         tamaño), y la fila queda deshabilitada mientras el modo debug está apagado: con debug off no
         hay nada que borrar, porque apagarlo ya borra todo. -->
    <PreferenceCategory app:title="Debug">
        <SwitchPreferenceCompat
            app:key="pref_debug_mode"
            app:title="Debug mode"
            app:summary="Record a log per playback (video, audio track, subtitles, auto-sync and translation runs). Turning it off deletes the logs. API keys are never written."
            app:defaultValue="false" />
        <Preference
            app:key="pref_debug_clear_logs"
            app:title="Clear debug logs" />
    </PreferenceCategory>

</PreferenceScreen>
